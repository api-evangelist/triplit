{
  "opencollection": "1.0.0",
  "info": {
    "name": "Triplit HTTP Advanced Auth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update authentication token for a sync connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{projectId}.triplit.io/update-token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the JWT token for an active WebSocket sync connection identified by clientId. Useful for token refresh without reconnecting. Roles must remain equivalent between old and new token."
        }
      ]
    }
  ],
  "bundled": true
}
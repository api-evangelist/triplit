        {
          "id": "48380704-7693-4b77-bb0d-e4c94ccbc3b4",
          "name": "Update authentication token for a sync connection",
          "request": {
            "name": "Update authentication token for a sync connection",
            "description": {
              "content": "Updates the JWT token for an active WebSocket sync connection identified by clientId. Useful for token refresh without reconnecting. Roles must remain equivalent between old and new token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "update-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Triplit project ID",
                  "type": "any",
                  "value": "{{projectId}}",
                  "key": "projectId"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "1013af10-f145-4385-af8b-028cb3cdfa9c",
